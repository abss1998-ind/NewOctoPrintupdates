         <string notr="true">QProgressBar {
    border: none;
    border-radius: 10px;
    background-color: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #3a3a3a,
        stop:1 #505050
    );
    text-align: center;
margin: 2px;
margin-right:10px;
margin-left:10px;
}


QProgressBar::chunk {
    border-radius: 10px;
    background: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #52ff56,
        stop:0.3 #2ee937,
        stop:0.6 #1ec12d,
        stop:1 #179226
    );
    margin: 1px;
}
