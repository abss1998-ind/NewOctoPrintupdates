          <property name="styleSheet">
           <string notr="true">QSpinBox {
border-bottom-left-radius: 15px;
border-top-left-radius: 15px;
qproperty-alignment: 'AlignVCenter | AlignHCenter';
border: 1px solid rgb(87, 87, 87);
	background-color: rgb(255, 255, 255);
}

QSpinBox ::text {
	background-color: rgb(255, 146, 57);
}

QSpinBox ::text:selected {
	background-color: rgb(255, 146, 57);
   
}
QSpinBox::up-button {
     border-left: 1px solid rgb(87, 87, 87);
border-bottom: 1px solid rgb(87, 87, 87);

    min-width: 60px;   /* sets minimal button width */
	background-color: qlineargradient(spread:pad, x1:0, y1:1, x2:0, y2:0.188, stop:0 rgba(180, 180, 180, 255), stop:1 rgba(255, 255, 255, 255));
}

QSpinBox::up-arrow { image: url(:/Navigation/img/Navigation/arrows.png);
    width: 25px;
     height: 25px;
padding: 5px; 
}



QSpinBox::up-button:pressed {
    background-color: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
                                      stop: 0 #dadbde, stop: 1 #f6f7fa);
}


QSpinBox::down-button {
     border-left: 1px solid rgb(87, 87, 87);
border-top: 1px solid rgb(87, 87, 87);
    min-width: 60px;   /* sets minimal button width */
	background-color: qlineargradient(spread:pad, x1:0, y1:1, x2:0, y2:0.188, stop:0 rgba(180, 180, 180, 255), stop:1 rgba(255, 255, 255, 255));
margin-top: -2px;

}

QSpinBox::down-arrow {image: url(:/Navigation/img/Navigation/arrows-5.png);
    width: 25px;
     height: 25px;
padding: 5px;
}

QSpinBox::down-button:pressed {
    background-color: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
                                      stop: 0 #dadbde, stop: 1 #f6f7fa);

}

</string>
