	background-color: rgb(255, 146, 57);
}

QSpinBox ::text:selected {
	background-color: rgb(255, 146, 57);
   
}
QSpinBox::up-button {
     border-left: 1px solid rgb(87, 87, 87);
border-bottom: 1px solid rgb(87, 87, 87);

    min-width: 60px;   /* sets minimal button width */
	background-color: qlineargradient(spread:pad, x1:0, y1:1, x2:0, y2:0.188, stop:0 rgba(180, 180, 180, 255), stop:1 rgba(255, 255, 255, 255));
}

QSpinBox::up-arrow { image: url(:/Navigation/img/Navigation/arrows.png);
    width: 25px;
     height: 25px;
padding: 5px; 
}



